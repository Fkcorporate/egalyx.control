+# ============================================================================
+# COTATION UNIFIÉE — branchement de cotation.py dans l'application
+# ----------------------------------------------------------------------------
+#  1. Écouteur SQLAlchemy : toute évaluation enregistrée (quelle que soit la
+#     route qui la crée) reçoit automatiquement ses scores BRUT/NET et ses
+#     niveaux selon la règle unique. Plus aucune route ne peut écrire
+#     « score_risque = impact × probabilité » avec une autre règle.
+#  2. Globals Jinja pour les templates (macro _macros/cotation.html).
+#  3. Recalcul des évaluations déjà en base (commande + page super admin).
+# ============================================================================
+import cotation as cotation_regle
+from sqlalchemy import event as cotation_sa_event
+
+try:
+    from models import EvaluationRisque as _CotationEvaluationRisque
+except Exception as _e_cot:  # pragma: no cover
+    _CotationEvaluationRisque = None
+    print(f"⚠️ Cotation : modèle EvaluationRisque introuvable ({_e_cot})")
+
+
+if _CotationEvaluationRisque is not None:
+    @cotation_sa_event.listens_for(_CotationEvaluationRisque, 'before_insert')
+    @cotation_sa_event.listens_for(_CotationEvaluationRisque, 'before_update')
+    def _cotation_avant_enregistrement(mapper, connection, evaluation):
+        try:
+            cotation_regle.appliquer(evaluation)
+        except Exception as e:  # ne jamais bloquer un enregistrement
+            print(f"⚠️ Cotation non appliquée (évaluation {getattr(evaluation, 'id', '?')}) : {e}")
+
+
+# ---------------------------------------------------------------- Jinja
+app.jinja_env.globals.update(
+    cotation_niveau=cotation_regle.niveau,              # score → 'Élevé'
+    cotation_style=cotation_regle.style,                # niveau ou score → {cle, hex, texte, bs, action, niveau}
+    cotation_normaliser=cotation_regle.normaliser,      # 'eleve' → 'Élevé'
+    cotation_evaluation=cotation_regle.depuis_evaluation,  # évaluation → dict brut/net
+    cotation_scores=cotation_regle.scores,              # (impact, proba, maîtrise) → dict brut/net
+    cotation_config_js=cotation_regle.config_js,        # pour window.EgalyxCotation
+    COTATION_SEUILS=cotation_regle.SEUILS,
+    calculer_niveau_risque=calculer_niveau_risque,      # version unique (score) ou (impact, proba)
+)
+app.jinja_env.filters['niveau_risque'] = cotation_regle.niveau
+
+
+# ---------------------------------------------------------------- Recalcul
+def recalculer_toutes_cotations(client_id=None, lot=500):
+    """
+    Recalcule toutes les évaluations avec la règle unique.
+    Retourne (nb_lues, nb_modifiees). client_id=None → tous les clients.
+    """
+    if _CotationEvaluationRisque is None:
+        return 0, 0
+    q = _CotationEvaluationRisque.query
+    if client_id is not None and hasattr(_CotationEvaluationRisque, 'client_id'):
+        q = q.filter(_CotationEvaluationRisque.client_id == client_id)
+    lues = modifiees = 0
+    for ev in q.order_by(_CotationEvaluationRisque.id).yield_per(lot):
+        lues += 1
+        avant = (getattr(ev, 'score_risque', None), getattr(ev, 'niveau_risque', None),
+                 getattr(ev, 'score_risque_brut', None), getattr(ev, 'niveau_risque_brut', None))
+        cotation_regle.appliquer(ev)
+        apres = (getattr(ev, 'score_risque', None), getattr(ev, 'niveau_risque', None),
+                 getattr(ev, 'score_risque_brut', None), getattr(ev, 'niveau_risque_brut', None))
+        if avant != apres:
+            modifiees += 1
+        if lues % lot == 0:
+            db.session.flush()
+    db.session.commit()
+    return lues, modifiees
+
+
+@app.cli.command('recalculer-cotations')
+def _cli_recalculer_cotations():
+    """flask recalculer-cotations : remet toutes les évaluations à la règle unique."""
+    lues, modifiees = recalculer_toutes_cotations()
+    print(f"✅ {lues} évaluation(s) relue(s), {modifiees} corrigée(s).")
+
+
