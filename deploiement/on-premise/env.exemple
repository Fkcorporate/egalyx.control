# ============================================================================
# Egalyx Control — réglages de l'installation chez le client
# Copiez ce fichier à la racine du projet sous le nom .env :   cp deploiement/on-premise/env.exemple .env
# Ne transmettez jamais le fichier .env rempli par e-mail : il contient des mots de passe.
# ============================================================================

# --- Sécurité (OBLIGATOIRE) -------------------------------------------------
# Valeur aléatoire de 50 caractères. Pour en générer une :
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# --- Licence (OBLIGATOIRE) --------------------------------------------------
# Clé fournie par Egalyx (une seule ligne commençant par EGX1-). Elle peut aussi être
# collée plus tard par le super administrateur sur la page https://<adresse>/licence
EGALYX_LICENCE=

# --- Base de données (OBLIGATOIRE) ------------------------------------------
POSTGRES_DB=egalyx
POSTGRES_USER=egalyx
# Mot de passe long et aléatoire (même commande que ci-dessus)
POSTGRES_PASSWORD=

# --- Adresse du site --------------------------------------------------------
# Adresse interne choisie par le client, ex. egalyx.sodemi.ci
EGALYX_DOMAINE=egalyx.client.local
PORT_HTTP=80
PORT_HTTPS=443
# Mettre 0 UNIQUEMENT pour un essai sans certificat HTTPS
EGALYX_HTTPS=1

# --- E-mails (notifications, relances, lettres de mission) -----------------
# Serveur d'envoi du client (Exchange, Office 365, Gmail…)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
# Adresse et nom d'expéditeur des e-mails (ex. audit@sodemi.ci / Audit interne SODEMI)
MAIL_DEFAULT_SENDER=
MAIL_NOM_EXPEDITEUR=

# --- Sauvegardes ------------------------------------------------------------
# Sauvegarde automatique de la base chaque nuit (heure du serveur)
EGALYX_SAUVEGARDE_AUTO=1
EGALYX_SAUVEGARDE_HEURE=2

# --- Fuseau horaire du serveur ---------------------------------------------
TZ=Africa/Abidjan

# --- Intelligence artificielle (facultatif) --------------------------------
# Laisser vide si le client refuse que des données sortent de son réseau.
OPENAI_API_KEY=
